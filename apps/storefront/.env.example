# Address of the Autoxide core server (without /api/v1). Only the server side of this
# website talks to it; browsers never call the core directly (pictures go through
# /api/v1/media/… of the website).
# Default: http://127.0.0.1:8080
#AUTOXIDE_API_URL=http://127.0.0.1:8080

# Public address of the website, without a trailing slash: used for canonical links,
# Open Graph, sitemap.xml and the RSS feed.
# Default: http://localhost:3000
#AUTOXIDE_STOREFRONT_URL=https://www.example.com

# Name of the shop shown in the header, footer and page titles. Unset: the sample shop's
# name while sample data is on, "Autoxide" otherwise.
#AUTOXIDE_STOREFRONT_NAME=

# Look of the website: default, market, minimal or luxe.
# Default: default
#AUTOXIDE_STOREFRONT_THEME=default

# Show sample data for the parts the core has no API for yet (products, prices, stores,
# cart; marked "sample" on the page). Default: on in development, off in production.
#AUTOXIDE_WEB_SAMPLE_DATA=false
