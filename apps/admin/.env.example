# Address of the Autoxide core server (without /api/v1). Only the server side of this
# app talks to it; browsers never call the core directly.
# Default: http://127.0.0.1:8080
#AUTOXIDE_API_URL=http://127.0.0.1:8080

# Send session cookies only over HTTPS. Default: on in production (`next start`),
# off in development. Turn it off only when the app is served over plain HTTP.
#AUTOXIDE_WEB_SECURE_COOKIES=true
