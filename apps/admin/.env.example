# Address of the Autoxide core server (without /api/v1). Only the server side of this
# app talks to it; browsers never call the core directly.
# Default: http://127.0.0.1:8080
#AUTOXIDE_API_URL=http://127.0.0.1:8080

# Send session cookies only over HTTPS. Default: on in production (`next start`),
# off in development. Turn it off only when the app is served over plain HTTP.
#AUTOXIDE_WEB_SECURE_COOKIES=true

# Show sample data for the parts the core has no API for yet (marked "Sample data" on screen).
# Default: on in development, off in production (`next start`).
#AUTOXIDE_WEB_SAMPLE_DATA=false

# Only when the core runs several tenants (AUTOXIDE_TENANCY_MODE=multi): the slug or ID of the
# tenant this admin is for. Leave empty to let people type their workspace when they sign in,
# or to serve the admin on each tenant's verified domain.
#AUTOXIDE_ADMIN_TENANT=acme
