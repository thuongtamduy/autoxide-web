{
  "name": "autoxide-web",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "sdk:generate": "pnpm --filter @autoxide/sdk generate",
    "e2e": "turbo run e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2"
  }
}
